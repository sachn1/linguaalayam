DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=linguaalayam
# DB_SSLMODE=require   # uncomment for hosted Postgres (Supabase etc.)

# TOGETHER_API_KEY=tgp_...     # required for the web app's server-side AI synthesis (Qwen 3.5 9B, no user key needed) and llm=togetherai
# ANTHROPIC_API_KEY=sk-ant-... # optional — only needed for llm=anthropic (CLI only; web app is bring-your-own-key for Anthropic)
# OPENAI_API_KEY=sk-...        # optional — only needed for llm=openai (CLI only; web app is bring-your-own-key for OpenAI)

# OAuth 2.0 issuer URL — must match the public URL where /mcp is reachable.
# Determines the base for /.well-known/oauth-authorization-server, /authorize, /token, /register.
# Production: https://linguaalayam.org/mcp
MCP_ISSUER_URL=http://localhost:8000/mcp

# HTTP Basic Auth credentials gating /admin/analytics (traffic/usage dashboard).
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Windows (WSL) users — optionally store secrets in Windows Credential Manager
# instead of writing them here:
#   New-StoredCredential -Target "DB_PASSWORD"       -UserName x -Password yourpassword -Persist LocalMachine
# Then add retrieval to ~/.bashrc — see docs/setup.md
